{
  "name": "atlaps",
  "version": "0.1.0",
  "private": true,
  "description": "Atlaps · Iniciativa Alexendros, S.L. · atlas SaaS domótica con estética blueprint independiente.",
  "author": "Iniciativa Alexendros, S.L.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "bash scripts/build-socios.sh && next build",
    "build:socios": "bash scripts/build-socios.sh",
    "build:showcase": "bash scripts/build-showcase.sh",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.1",
    "vite": "8.1.6",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-tailwindcss": "3.18.3",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.7",
    "postcss": "8.5.28",
    "prettier": "3.8.4",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
