# Atlaps · portal raíz (app/) — plantilla de entorno
# Copia a .env.local. No pongas valores reales ni commitees secretos.

# URL pública del portal (sin barra final). Fallback en código: https://atlaps.local
NEXT_PUBLIC_BASE_URL=

# Contacto /socios → Resend
RESEND_API_KEY=
CONTACTO_FROM=
CONTACTO_TO=

# Inyectadas por la plataforma (no rellenar en local salvo pruebas):
# VERCEL_ENV=  # preview | production | development
# NODE_ENV=    # development | production | test
# CI=          # true en pipelines

# En producción, sin RESEND_API_KEY el endpoint falla cerrado (no mock).
