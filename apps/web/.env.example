# Atlaps · apps/web · environment template
# Copia este archivo a .env.local y rellena los valores reales (no commitear).

# Public site URL (sin trailing slash). Producción: https://atlaps.com
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Supabase (waitlist) ---
# Backend self-host en F0 · cloud EU como fallback (flag WAITLIST_BACKEND).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
WAITLIST_BACKEND=selfhost

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Preferidos por el portal raíz (app/api/contacto):
CONTACTO_FROM=Atlaps <noreply@atlaps.com>
CONTACTO_TO=contacto@alexendros.me
# Alias legacy / apps/web:
RESEND_FROM_EMAIL=noreply@mail.atlaps.com

# --- Observabilidad ---
NEXT_PUBLIC_GLITCHTIP_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=atlaps.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
